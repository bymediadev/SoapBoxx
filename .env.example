# Copy to ".env" in the repo root (setup_local.ps1 can do this). SoapBoxx loads it at startup.

# Optional: per-show editorial profile overlay (JSON). See config/editorial_profiles.example.json
# SOAPBOXX_EDITORIAL_REGISTRY=config/editorial_profiles.json

# --- Ollama (required for real v2 strict brief; coach/workflow can use Groq instead — see below) ---
OLLAMA_HOST=http://127.0.0.1:11434
# Ollama is the default **v2 brief / strict JSON contract** extractor (long transcript → brief JSON).
# Recommended: llama3.1:8b for dev, fast iteration, and machines with limited VRAM.
# For company / shipped installs on capable hardware, use llama3.1:70b here instead.
SOAPBOXX_OLLAMA_MODEL=llama3.1:8b

# Optional: structured stderr heartbeats during blocking Ollama HTTP (distinguish long runs from hangs).
# SOAPBOXX_OLLAMA_HEARTBEAT=1
# SOAPBOXX_OLLAMA_HEARTBEAT_INTERVAL_SEC=30
# SOAPBOXX_OLLAMA_HEARTBEAT_SOFT_SEC=180

# Ollama HTTP resilience (shared /api/chat client): split timeouts, bounded retries, transport log on metadata.
# SOAPBOXX_OLLAMA_MAX_RETRIES=3
# SOAPBOXX_OLLAMA_FIRST_BYTE_TIMEOUT=900
# SOAPBOXX_OLLAMA_READ_BODY_TIMEOUT=900
# SOAPBOXX_OLLAMA_HTTP_TIMEOUT=900
# Optional: correlate stderr heartbeats with a run (also set automatically per workflow as metadata.trace_id).
# SOAPBOXX_TRACE_ID=

# --- Full podcast run (30–90+ min captions, 100k+ chars) ---
# Prefer the CLI preset instead of copying by hand:
#   python scripts/run_youtube_podcast_v3_test.py --preset full --id <VIDEO_ID> --title "..." --creator "..." --out reports/run.md
# Or inspect keys:
#   python scripts/run_youtube_podcast_v3_test.py --list-presets
# The ``full`` preset sets long HTTP timeouts, heartbeats, and raises SOAPBOXX_BRIEF_MAX_CHARS / WORKFLOW_MAX_WORDS.

# Log JSON parse failures with truncation heuristics (stderr). Implied when SOAPBOXX_OLLAMA_DEBUG=1.
# SOAPBOXX_JSON_INTEGRITY_LOG=1
# SOAPBOXX_OLLAMA_DEBUG=1

# One-pass brief limit (chars). Repo default when unset is 200000 in code (see episode_intelligence).
# Lower this if your Ollama model context is small; raise only if you have headroom.
SOAPBOXX_BRIEF_MAX_CHARS=200000

# --- Unified run (single entrypoint) ---
# Programmatic: ``from unified_episode_run import run_unified_episode_pipeline`` then one call returns
# ``report_v3``, canonical ``workflow_report``, merged ``warnings``, ``markdown_export``, ``pipeline``, ``dialin``.
# (Same stack as ``generate_episode_report_v3`` + ``soapboxx_v3_workflow_local``, without ad-hoc merging.)
# SoapBoxx-Local-Workflow ``soapboxx_backend_bridge.export_soapboxx_v3_workflow`` uses this by default and
# writes ``episode_unified_bundle.json`` next to ``soapboxx_workflow_report.json``. Set 0 to force legacy bridge:
# SOAPBOXX_USE_UNIFIED_PIPELINE=0

# --- API-style episode brief (recommended for Local Workflow / production) ---
# Strict JSON contract: one generation + one repair pass; maps into v2 brief for v3 (see backend/strict_episode_contract.py).
# Default in code is ON. Set 0 (or "legacy") only if you need the old text/data envelope + schema-hint path.
# SOAPBOXX_BRIEF_STRICT_CONTRACT=0
# Spine-first argument pipeline (two LLM passes: spine + hostile critic) → same v2 brief;
# preserves argument_spine / argument_critic on the brief. Requires strict contract on.
# SOAPBOXX_BRIEF_SPINE_FIRST=1
# Second LLM (critic) on by default when spine-first is on; set 0 to save latency/cost.
# SOAPBOXX_BRIEF_SPINE_CRITIC=0
# Third LLM (refiner: repairs from pass 1 + 2 JSON only, no transcript). Set 0 for two-pass only.
# SOAPBOXX_BRIEF_SPINE_REFINE=0
# When refine is on, top-level claims stay pass-1 ``text`` unless the promotion gate passes (critic
# thesis weak, refiner issues_remaining empty, ≥2 refiner claims); then ``refined_text`` is added only
# if drift heuristics pass. ``argument_topic`` follows the refiner thesis only when promoted.
# Optional JSON for v3 ``report_readiness.intelligence_ship`` weights/thresholds (see config/ship_gate.json).
# SOAPBOXX_SHIP_GATE_CONFIG=config/ship_gate.json
#
# Claim entry gate (``claim_filter_v2``) runs in ``_normalize_brief`` after LLM claims are cleaned.
# Set to 0 to skip. Mode: production (slim) vs debug (full decision traces on each row).
# SOAPBOXX_CLAIM_FILTER_V2=1
# SOAPBOXX_CLAIM_FILTER_MODE=production
# Attach full filter JSON to ``_claim_filter_v2`` even in production (for file logging).
# SOAPBOXX_CLAIM_FILTER_DEBUG_TRACE=0
# Require explicit causal/mechanism wording on each claim (see ``backend/causal_claim.py``). 0 = legacy.
# SOAPBOXX_CLAIM_REQUIRE_CAUSAL=1
#
# After v3 ``build_v3_report``, run :mod:`backend.episode_brief_v2` on transcript-derived segments,
# attach ``report_v3.episode_brief_v2``, override coach/narrative thesis when valid, prepend a visible
# markdown block to unified export, and force diagnostic when v2 thesis is unavailable.
# SOAPBOXX_BRIEF_V2=0
# Max transcript chars sent into the strict contract call (default 48000 ~ long caption runs).
# Lower on small-RAM machines; raise up to 120000 if your Ollama context allows.
# SOAPBOXX_BRIEF_CONTRACT_MAX_CHARS=48000
# When over cap, pack opening + closing transcript windows (default ON). Set 0 for legacy head-only slice.
# SOAPBOXX_BRIEF_CONTRACT_MULTI_WINDOW=0
# Fraction of the inner budget (excluding markers) given to the opening window; remainder is closing (default 0.58).
# SOAPBOXX_BRIEF_CONTRACT_HEAD_FRACTION=0.58
# Legacy envelope brief: do NOT parse episode JSON from envelope "text" unless explicitly enabled.
# SOAPBOXX_LLM_ENVELOPE_TEXT_FALLBACK=0

# --- Brief parse guardrails (tape grounding) ---
# After JSON shape checks, reject briefs whose claims/narrative do not visibly overlap the transcript
# (token recall vs transcript sentences). Triggers the same retry feedback loop as schema failures.
# Default in code is ON. Set 0 only if a model legitimately paraphrases so heavily that recall fails.
# SOAPBOXX_BRIEF_TRANSCRIPT_GUARDRAILS=0
# Minimum token-recall score (0–1) for each claim vs best-matching transcript sentence.
# SOAPBOXX_BRIEF_MIN_TRANSCRIPT_ANCHOR=0.06
# Skip grounding checks when the transcript is shorter than this many words.
# SOAPBOXX_BRIEF_GUARD_MIN_WORDS=120
# Strict strict-contract transport: if set, invalid JSON raises instead of loose json-repair fallback.
# SOAPBOXX_STRICT_JSON_NO_LOOSE=1

# When the model returns malformed JSON or a bad envelope, brief synthesis retries (extra attempts after the first).
# Default 2 extra => 3 envelope tries total (max 6). Raise on flaky small models.
# SOAPBOXX_BRIEF_ENVELOPE_RETRIES=3
# After a failed primary brief, one recovery pass retruncates the transcript (default on).
# SOAPBOXX_BRIEF_RECOVERY=0
# SOAPBOXX_BRIEF_RECOVERY_MAX_CHARS=32000
# Log a truncated preview of assistant content on coerce failure (also implied by SOAPBOXX_OLLAMA_DEBUG=1).
# SOAPBOXX_BRIEF_ENVELOPE_DEBUG=1

# Match context to your model and VRAM. llama3.1 supports large windows; 8k is safe on modest GPUs.
# For long one-pass briefs, try 131072 only if your Ollama runner can load the model at that size.
# SOAPBOXX_OLLAMA_NUM_CTX=8192
# SOAPBOXX_OLLAMA_NUM_CTX=131072

# --- Gemini (recommended for insight / workflow LLM when Groq is not used) ---
# Uses GOOGLE_API_KEY from your Google Cloud / AI Studio project (Generative Language API enabled).
# SOAPBOXX_GEMINI_MODEL=gemini-2.0-flash
# SOAPBOXX_WORKFLOW_LLM_BACKEND=gemini
# SOAPBOXX_COACH_SYNTH_BACKEND=gemini
# SOAPBOXX_ANALYSIS_PROVIDER=gemini

# --- Groq (optional legacy) ---
# If GROQ_API_KEY is set, workflow enrichment can use Groq when SOAPBOXX_WORKFLOW_LLM_BACKEND=groq.
# GROQ_API_KEY=
# SOAPBOXX_WORKFLOW_LLM_BACKEND=groq
# Reverb tab (YouTube / Podchaser discovery): after API hits load, optional LLM summary uses ``call_llm``
# (Groq when configured, else Ollama). Set 0 to keep static hints only.
# SOAPBOXX_REVERB_SEARCH_LLM=0
# SOAPBOXX_GROQ_WORKFLOW_MODEL=llama-3.1-8b-instant
# SOAPBOXX_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: second LLM pass for the v3 **coach** (diagnosis, uncomfortable read, contrarian, themes) plus,
# when the model returns them, **episode-specific** immediate fix plan, follow-ups, segment upgrade, bottom line,
# where-it-breaks bullets, and clip moments — uses CURRENT_COACH_SKETCH in the prompt so output beats templates.
# SOAPBOXX_COACH_SYNTH=1
#
# $0 backends (no OpenAI billing):
#   (1) Ollama — local, same as brief: set SOAPBOXX_OLLAMA_MODEL + run Ollama (see top of this file).
#   (2) Groq — free API tier after signup: https://console.groq.com — set GROQ_API_KEY (or SOAPBOXX_GROQ_API_KEY).
#       Example: SOAPBOXX_COACH_SYNTH_BACKEND=groq
#       Model default: SOAPBOXX_GROQ_COACH_MODEL=llama-3.1-8b-instant (override if Groq renames tiers).
# Auto order when BACKEND unset: OpenAI key → Groq key → Ollama model.
# Force backend: SOAPBOXX_COACH_SYNTH_BACKEND=openai|groq|ollama
# SOAPBOXX_OPENAI_COACH_MODEL=gpt-4o-mini
# SOAPBOXX_COACH_SYNTH_EXCERPT_CHARS=14000

# Keep workflow LLM enrichment on for richer highlights / evidence (default 1).
# SOAPBOXX_WORKFLOW_USE_AI=0

# Do not skip the transcript quality gate unless you know the source is strong (skipping can add noise).
# SOAPBOXX_WORKFLOW_SKIP_GATE=1

# Strict markdown export: one truth gate (reality check + ≥2 grounded evidence rows + ≥1 segment, max of workflow vs report_v3).
# Failure card instead of a faux-complete strategist report. Master Blueprint strategist_report does not bypass the same gate.
# SOAPBOXX_STRICT_EXPORT=0

# Legacy: inject synthetic evidence when the map is empty so JSON validation can pass (discouraged; default off).
# SOAPBOXX_WORKFLOW_FALLBACK_EVIDENCE=1

# Compress strategist markdown when signal is borderline: omit upgrade/guests/network blocks; add “If You Had to Act Anyway” (existing signal only). Default 1.
# SOAPBOXX_EXPORT_COMPRESSION=0

# When workflow AI returns too little structure, run a rule-based pass on captions (clean → sentences → anchor quotes) so the export gate can get ≥2 grounded evidence rows + ≥1 segment. Tags rows confidence=low, source=rule_based_inference. Default 1.
# SOAPBOXX_CAPTION_STRUCTURE_BOOTSTRAP=0

# Jaccard threshold (token sets over claims) for dropping near-duplicate rule-based anchors. Default 0.7.
# SOAPBOXX_CLAIM_DEDUPE_JACCARD=0.75

# Episode-to-episode progress (optional): persist last snapshot per show key and add “Progress Since Last Episode” to the next export. Metadata export_telemetry stamps are always on successful exports; this only enables the file + delta section. Default 0.
# SOAPBOXX_EPISODE_PROGRESS=1
# Override state file path (default: %LOCALAPPDATA%\SoapBoxx\episode_progress_state.json on Windows, ~/.soapboxx/episode_progress_state.json elsewhere)
# SOAPBOXX_EPISODE_PROGRESS_STATE=C:\path\to\episode_progress_state.json

# OLLAMA_NUM_CTX is an alias for SOAPBOXX_OLLAMA_NUM_CTX (see Ollama section above).

# --- YouTube captions (scripts that use yt-dlp; see backend/youtube_subtitles.py) ---
# Seconds between manual-vs-auto subtitle attempts (default 1.0)
# SOAPBOXX_YTDLP_SLEEP_INTERVAL=1
# Per-request throttling passed to yt-dlp (defaults 1 and 5)
# SOAPBOXX_YTDLP_SLEEP_REQUESTS=1
# SOAPBOXX_YTDLP_MAX_SLEEP=5
#
# ``scripts/episode_intake.py --url … --youtube-transcript asr`` downloads audio (ffmpeg) then runs
# ``SOAPBOXX_TRANSCRIBER`` (see ``backend/transcriber.py``). OpenAI Whisper HTTP caps ~25MB — for long
# shows use ``SOAPBOXX_TRANSCRIBER=local`` or ``assemblyai``, or raise ffmpeg compression, e.g.:
# SOAPBOXX_YOUTUBE_ASR_AUDIO_QUALITY=5
# ``--youtube-transcript auto`` scores caption quality and escalates to ASR when weak.
# Lower = keep captions more often; higher = escalate to ASR more aggressively.
# SOAPBOXX_YOUTUBE_AUTO_ASR_SCORE=0.62

# --- Master Blueprint v1 (multi-lens classify → narrative → analytical → thesis → clips → synthesis) ---
SOAPBOXX_BLUEPRINT_V1=1

# Wrapper / fork sanity: ensure only one backend is imported (run from repo root):
#   python scripts/verify_soapboxx_backend.py

# --- Optional: skip all LLM (empty brief shell) ---
# SOAPBOXX_OFFLINE=1

# --- v3 reality check (runs inside soapboxx_v3_workflow_local; see backend/data/v3_reality_expected.json) ---
# SOAPBOXX_V3_REALITY_CHECK=0
# SOAPBOXX_V3_REALITY_RULES=C:\path\to\custom_reality_rules.json
# SOAPBOXX_V3_REALITY_STRICT=1


# --- v3 Episode Report markdown export (render_episode_report_v3_markdown) ---
# full = classic: §0 readiness + producer/rigor, then spine, then full coach order.
# freebie = preview: follow-up questions + guest strategy first, quick snapshot + spine, coaching, then "Deeper" for full readiness + workflow + argument rigor; dual lens and sign-off renumbered.
# Default in code when unset: full (tests/CI). scripts/episode_intake.py sets default freebie if you do not define this in .env.
# SOAPBOXX_V3_FRAMING=full
# SOAPBOXX_V3_FRAMING=freebie

# --- Guest questions (framing / extraction) ---
# Tone for LLM question rewrite: curious | direct | warm
# SOAPBOXX_QUESTION_STYLE=curious
# Max questions per live extract pass (default 5)
# SOAPBOXX_QUESTION_MAX=5
# Set 1 to inject generic keyword-based question hints on live chunks (not transcript-grounded)
# SOAPBOXX_KEYWORD_QUESTION_HINTS=0
# Auto-suggest while recording: min transcript length before first pass (default 30)
# SOAPBOXX_QUESTION_MIN_CHARS=30
# New characters since last pass before re-running LLM (default 40)
# SOAPBOXX_QUESTION_MIN_GROWTH_CHARS=40
# Max transcript tail sent to the LLM per pass (default 3500)
# SOAPBOXX_QUESTION_CONTEXT_CHARS=3500

# --- Live recording transcription (SoapBoxx tab while recording) ---
# How much audio each STT pass analyzes (default 15). Set to 10 for 10-second windows.
# SOAPBOXX_LIVE_TRANSCRIPT_WINDOW_SEC=10
# How often to run STT while recording (default 10). Must be <= window size.
# SOAPBOXX_LIVE_TRANSCRIPT_STEP_SEC=10

# --- Modular provider pipeline (backend/core + backend/providers) ---
# Swap transcription/analysis without code changes. Unset transcription provider keeps legacy Transcriber (openai/groq/local).
# SOAPBOXX_TRANSCRIPTION_PROVIDER=whisper
# SOAPBOXX_TRANSCRIPTION_PROVIDER=assemblyai
# SOAPBOXX_ANALYSIS_PROVIDER=gemini
# SOAPBOXX_GEMINI_MODEL=gemini-2.0-flash
# Legacy PyQt Coach tabs instead of Insights Library (/ui/): SOAPBOXX_STUDIO_UI=1
# Cloud library API (same data as Lovable): SOAPBOXX_LIBRARY_API_URL=https://soapboxx-production.up.railway.app
# When local Postgres is down, fall back to cloud (default on): SOAPBOXX_LIBRARY_FALLBACK_REMOTE=1

# --- Python (recommended on Windows) ---
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
