# Copy to ".env" in the repo root (setup_local.ps1 can do this). SoapBoxx loads it at startup.

# Optional: per-show editorial profile overlay (JSON). See config/editorial_profiles.example.json
# SOAPBOXX_EDITORIAL_REGISTRY=config/editorial_profiles.json

# --- Ollama (required for real v2 brief + v3 + workflow + Master Blueprint LLM stages) ---
OLLAMA_HOST=http://127.0.0.1:11434
# One model name for all LLM calls (there is no separate "workflow" vs "app" variable yet).
# Recommended: llama3.1:8b for dev, fast iteration, and machines with limited VRAM.
# For company / shipped installs on capable hardware, use llama3.1:70b here instead.
SOAPBOXX_OLLAMA_MODEL=llama3.1:8b

# Optional: structured stderr heartbeats during blocking Ollama HTTP (distinguish long runs from hangs).
# SOAPBOXX_OLLAMA_HEARTBEAT=1
# SOAPBOXX_OLLAMA_HEARTBEAT_INTERVAL_SEC=30
# SOAPBOXX_OLLAMA_HEARTBEAT_SOFT_SEC=180

# Ollama HTTP resilience (shared /api/chat client): split timeouts, bounded retries, transport log on metadata.
# SOAPBOXX_OLLAMA_MAX_RETRIES=3
# SOAPBOXX_OLLAMA_FIRST_BYTE_TIMEOUT=900
# SOAPBOXX_OLLAMA_READ_BODY_TIMEOUT=900
# SOAPBOXX_OLLAMA_HTTP_TIMEOUT=900
# Optional: correlate stderr heartbeats with a run (also set automatically per workflow as metadata.trace_id).
# SOAPBOXX_TRACE_ID=

# --- Full podcast run (30–90+ min captions, 100k+ chars) ---
# Prefer the CLI preset instead of copying by hand:
#   python scripts/run_youtube_podcast_v3_test.py --preset full --id <VIDEO_ID> --title "..." --creator "..." --out reports/run.md
# Or inspect keys:
#   python scripts/run_youtube_podcast_v3_test.py --list-presets
# The ``full`` preset sets long HTTP timeouts, heartbeats, and raises SOAPBOXX_BRIEF_MAX_CHARS / WORKFLOW_MAX_WORDS.

# Log JSON parse failures with truncation heuristics (stderr). Implied when SOAPBOXX_OLLAMA_DEBUG=1.
# SOAPBOXX_JSON_INTEGRITY_LOG=1
# SOAPBOXX_OLLAMA_DEBUG=1

# One-pass brief limit (chars). Repo default when unset is 200000 in code (see episode_intelligence).
# Lower this if your Ollama model context is small; raise only if you have headroom.
SOAPBOXX_BRIEF_MAX_CHARS=200000

# Keep workflow LLM enrichment on for richer highlights / evidence (default 1).
# SOAPBOXX_WORKFLOW_USE_AI=0

# Do not skip the transcript quality gate unless you know the source is strong (skipping can add noise).
# SOAPBOXX_WORKFLOW_SKIP_GATE=1

# Strict markdown export: one truth gate (reality check + ≥2 grounded evidence rows + ≥1 segment, max of workflow vs report_v3).
# Failure card instead of a faux-complete strategist report. Master Blueprint strategist_report does not bypass the same gate.
# SOAPBOXX_STRICT_EXPORT=0

# Legacy: inject synthetic evidence when the map is empty so JSON validation can pass (discouraged; default off).
# SOAPBOXX_WORKFLOW_FALLBACK_EVIDENCE=1

# Compress strategist markdown when signal is borderline: omit upgrade/guests/network blocks; add “If You Had to Act Anyway” (existing signal only). Default 1.
# SOAPBOXX_EXPORT_COMPRESSION=0

# When workflow AI returns too little structure, run a rule-based pass on captions (clean → sentences → anchor quotes) so the export gate can get ≥2 grounded evidence rows + ≥1 segment. Tags rows confidence=low, source=rule_based_inference. Default 1.
# SOAPBOXX_CAPTION_STRUCTURE_BOOTSTRAP=0

# Jaccard threshold (token sets over claims) for dropping near-duplicate rule-based anchors. Default 0.7.
# SOAPBOXX_CLAIM_DEDUPE_JACCARD=0.75

# Episode-to-episode progress (optional): persist last snapshot per show key and add “Progress Since Last Episode” to the next export. Metadata export_telemetry stamps are always on successful exports; this only enables the file + delta section. Default 0.
# SOAPBOXX_EPISODE_PROGRESS=1
# Override state file path (default: %LOCALAPPDATA%\SoapBoxx\episode_progress_state.json on Windows, ~/.soapboxx/episode_progress_state.json elsewhere)
# SOAPBOXX_EPISODE_PROGRESS_STATE=C:\path\to\episode_progress_state.json

# Optional: Ollama context window
# OLLAMA_NUM_CTX=8192

# --- YouTube captions (scripts that use yt-dlp; see backend/youtube_subtitles.py) ---
# Seconds between manual-vs-auto subtitle attempts (default 1.0)
# SOAPBOXX_YTDLP_SLEEP_INTERVAL=1
# Per-request throttling passed to yt-dlp (defaults 1 and 5)
# SOAPBOXX_YTDLP_SLEEP_REQUESTS=1
# SOAPBOXX_YTDLP_MAX_SLEEP=5

# --- Master Blueprint v1 (multi-lens classify → narrative → analytical → thesis → clips → synthesis) ---
SOAPBOXX_BLUEPRINT_V1=1

# --- Optional: skip all LLM (empty brief shell) ---
# SOAPBOXX_OFFLINE=1

# --- v3 reality check (runs inside soapboxx_v3_workflow_local; see backend/data/v3_reality_expected.json) ---
# SOAPBOXX_V3_REALITY_CHECK=0
# SOAPBOXX_V3_REALITY_RULES=C:\path\to\custom_reality_rules.json
# SOAPBOXX_V3_REALITY_STRICT=1


# --- Python (recommended on Windows) ---
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
