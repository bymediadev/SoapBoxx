# SoapBoxx V1 API — copy to .env locally; on Railway set Variables in dashboard
#
# Railway Postgres plugin sets DATABASE_URL (postgres://...) — auto-normalized to psycopg2
DATABASE_URL=postgresql+psycopg2://soapboxx:soapboxx@127.0.0.1:5432/soapboxx_v1
#
# Optional: Redis plugin; /health shows degraded without it but API still runs
REDIS_URL=redis://127.0.0.1:6379/0
#
# Lovable frontend
SOAPBOXX_CORS_ORIGINS=https://soapboxx.lovable.app,http://localhost:5173
#
# Override if Railpack ignores railpack.json (highest priority)
# RAILPACK_START_CMD=sh scripts/railway_start.sh
