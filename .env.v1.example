# SoapBoxx V1 API — LOCAL DEV ONLY (uvicorn on your PC + Postgres in Docker)
#
# NEVER deploy this file to Railway with 127.0.0.1 — inside a container localhost
# is the container itself, not Postgres. On Railway: reference DATABASE_URL from
# the Postgres plugin (hostname like postgres.railway.internal, not 127.0.0.1).
#
# Start DB: docker compose -f docker-compose.v1.yml up -d
DATABASE_URL=postgresql+psycopg2://soapboxx:soapboxx@127.0.0.1:5432/soapboxx_v1
#
# Optional: Redis plugin; /health shows degraded without it but API still runs
REDIS_URL=redis://127.0.0.1:6379/0
#
# Lovable frontend
SOAPBOXX_CORS_ORIGINS=https://soapboxx.lovable.app,http://localhost:5173
#
# Transcription (V1 pipeline) — pick one:
# SOAPBOXX_STT_ACCURACY_MODE=true         # slower STT: large-v3, longer timeout, less compression
# GROQ_API_KEY=gsk_...                    # free tier at console.groq.com (recommended)
# SOAPBOXX_TRANSCRIPTION_SERVICE=groq     # optional; auto if Groq key set, no OpenAI
# SOAPBOXX_GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# OPENAI_API_KEY=sk-...                   # paid OpenAI Whisper API
# SOAPBOXX_TRANSCRIPTION_SERVICE=local    # free on PC only: pip install openai-whisper
# SOAPBOXX_TRANSCRIPTION_SERVICE=assemblyai
# ASSEMBLYAI_API_KEY=...                  # raw key in Authorization header (no Bearer)
# ASSEMBLYAI_SPEECH_MODELS=universal-3-pro,universal-2
# ASSEMBLYAI_API_BASE=https://api.assemblyai.com
# SOAPBOXX_ASSEMBLYAI_KEYTERMS=Planet Money,NPR,Federal Reserve                  # paid; speaker diarization → Host/Guest labels
#
# Override only if railway.toml ignored (not a build command)
# RAILPACK_START_CMD=sh scripts/start_api.sh
