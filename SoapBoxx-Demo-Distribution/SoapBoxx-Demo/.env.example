# MAIL_FROM / SMTP_* = Gmail you send from.
# Signups with an email get mail at that address. MAIL_TO = fallback (tester IDs) or set NOTIFY_USER_EMAILS=0 to use only MAIL_TO.

MAIL_TO=team@yourdomain.com

# Gmail account used to SEND mail (App Password on this account)
MAIL_FROM=whymastermind@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=whymastermind@gmail.com
SMTP_PASSWORD=paste-gmail-app-password-here

# NOTIFY_DISABLED=0
