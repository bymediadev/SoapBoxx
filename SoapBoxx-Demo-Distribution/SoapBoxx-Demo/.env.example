# Fastest path: copy this file to .env and fill the 6 lines below. Nothing else required.

MAIL_TO=whymastermind@gmail.com
MAIL_FROM=youraddress@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=paste-gmail-app-password-here

# Turn off all outbound email (log file still works)
# NOTIFY_DISABLED=0

# --- Optional (ignore if you use Gmail above) ---
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# NOTIFY_WEBHOOK_URL=
